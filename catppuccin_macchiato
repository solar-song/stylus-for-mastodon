/* =========================================================
   Mastodon "Catppuccin Macchiato" Custom Theme
   Vibe: Soothing dark pastel, rich contrast, balanced palette
   ========================================================= */

:root {
  /* Main Backgrounds & Canvas (Base & Crust) */
  --theme-color: #c6a0f6 !important;             /* Mauve */
  --background-color: #24273a !important;        /* Base */
  --background-border-color: #363a4f !important; /* Surface0 */
  --surface-background-color: #1e2030 !important;/* Mantle */

  /* Text & Typography Colors */
  --primary-text-color: #cad3f5 !important;      /* Text */
  --secondary-text-color: #a5adcb !important;    /* Subtext0 */
  --highlight-text-color: #f5a97f !important;    /* Peach */

  /* Action Buttons & Accent Elements */
  --active-nav-item-color: #c6a0f6 !important;   /* Mauve */
  --button-background-color: #c6a0f6 !important; /* Mauve */
  --button-hover-background-color: #b7bdf8 !important; /* Lavender */
}

/* Base App Layout Canvas */
body, 
.app-holder, 
.ui, 
.column, 
.columns-area, 
.scrollable {
  background-color: #24273a !important;
  color: #cad3f5 !important;
}

/* Individual Post / Status Cards */
.status, 
.focusable:focus, 
.detailed-status, 
.detailed-status__action-bar, 
.account__header__bar {
  background-color: #1e2030 !important;
  border-color: #363a4f !important;
}

/* Column Headers & Navigation Top Bars */
.column-header, 
.column-header__button, 
.column-header__collapsible-inner, 
.tabs-bar {
  background-color: #1e2030 !important;
  color: #c6a0f6 !important;
  font-weight: 700 !important;
  border-bottom: 2px solid #c6a0f6 !important;
}

.column-header__title, 
.column-header__title .column-header__back-button {
  color: #c6a0f6 !important;
}

/* Post Content & Text Override */
.status__content, 
.status__content p, 
.reply-indicator__content {
  color: #cad3f5 !important;
  font-size: 0.95rem !important;
  line-height: 1.5 !important;
}

/* Links & Hashtags */
.status__content a, 
.status__content a.unhandled-link, 
.hashtag {
  color: #7dc4e4 !important; /* Sapphire */
  font-weight: 600 !important;
  text-decoration: none !important;
}

.status__content a:hover, 
.hashtag:hover {
  text-decoration: underline !important;
  color: #8aadf4 !important; /* Blue */
}

/* Compose / Post Editor Area */
.compose-form, 
.compose-form .autosuggest-textarea__textarea {
  background-color: #1e2030 !important;
  color: #cad3f5 !important;
  border-radius: 8px !important;
}

.compose-form .autosuggest-textarea__textarea {
  border: 1px solid #363a4f !important;
}

.compose-form .autosuggest-textarea__textarea:focus {
  border-color: #c6a0f6 !important;
  box-shadow: 0 0 0 2px rgba(198, 160, 246, 0.25) !important;
}

/* Action Buttons (Publish / Toot) */
.button, 
.button.vulnerable {
  background-color: #c6a0f6 !important; /* Mauve */
  color: #181926 !important;            /* Crust */
  font-weight: bold !important;
  border-radius: 20px !important;
  transition: background-color 0.15s ease-in-out !important;
}

.button:hover, 
.button:active {
  background-color: #f5a97f !important; /* Peach */
  color: #181926 !important;
}

/* Interaction Icons (Reply, Boost, Favorite) */
.status__action-bar__button {
  color: #a5adcb !important;
}

.status__action-bar__button:hover {
  color: #8bd5ca !important; /* Teal */
}

.status__action-bar__button.active {
  color: #a6da95 !important; /* Green for Boost */
}

.status__action-bar__button.favourite.active {
  color: #eed49f !important; /* Yellow for Fav */
}

/* Sidebar & Navigation Selection */
.column-link {
  color: #a5adcb !important;
  border-radius: 6px !important;
}

.column-link:hover {
  background-color: #363a4f !important;
  color: #8bd5ca !important;
}

.column-link.active {
  background-color: #363a4f !important;
  color: #c6a0f6 !important;
  font-weight: bold !important;
}


/* =========================================================
   MASTODON FIX: Remove White Blank Blocks & Card Panels
   ========================================================= */

/* 1. Feed Container & Scroll Wrapper Overrides */
.feed-scrollable,
.item-list,
.item-list__single-topic,
.column-inline-form,
.getting-started__wrapper,
.getting-started {
  background-color: #24273a !important;
}

/* 2. Compose Panel & Text Input Area */
.compose-form .autosuggest-textarea__textarea,
.compose-form .compose-form__modifiers,
.compose-form .compose-form__buttons-wrapper,
.reply-indicator {
  background-color: #1e2030 !important;
  border-color: #363a4f !important;
}

.compose-form .autosuggest-textarea__textarea {
  background-color: #181926 !important;
}

/* 3. Post Feed Cards, Statuses & Boost Blocks */
.status,
.status__content,
.status__content__text,
.status__wrapper,
.focusable,
.focusable:focus,
.detailed-status,
.detailed-status__action-bar,
.account__header__bar,
.activity-stream {
  background-color: #24273a !important;
}

/* 4. Embedded Link Previews / News Cards */
.status-card,
.status-card__title,
.status-card__content,
.status-card.horizontal,
.status-card.compact {
  background-color: #1e2030 !important;
  border: 1px solid #363a4f !important;
  border-radius: 8px !important;
  color: #cad3f5 !important;
}

.status-card:hover {
  background-color: #363a4f !important;
  border-color: #c6a0f6 !important;
}

/* 5. Spoiler / Content Warning (CW) Folders & Polls */
.status__content .status__content__spoiler-link,
.poll__option__example,
.poll__option {
  background-color: #363a4f !important;
  color: #c6a0f6 !important;
}


/* =========================================================
   MASTODON FIX: Compose Form Outer Container & Fill
   ========================================================= */

/* Force the form element itself to match the background */
form.compose-form,
.compose-form {
  background: #24273a !important;
  background-color: #24273a !important;
  border-color: transparent !important;
  box-shadow: none !important;
}

/* Ensure any flex-fill wrapper inside the form doesn't revert to white */
form.compose-form > div,
.compose-form__wrapper {
  background: #24273a !important;
  background-color: #24273a !important;
}

/* Keep the actual text input area dark and readable */
.compose-form textarea,
.autosuggest-textarea__textarea,
.autosuggest-textarea_form_input textarea {
  background-color: #181926 !important;
  color: #cad3f5 !important;
  border: 1px solid #363a4f !important;
  border-radius: 8px !important;
}
